    function enviarAudioParaGoogleDrive(input, indice) {
      if (!input.files || !input.files[0]) return;
      var file = input.files[0];
      mostrarMensagem('Enviando "' + file.name + '" para o Google Drive...');

      var reader = new FileReader();
      reader.onload = function(e) {
        chamarApiGAS(
          "uploadMidia",
          {
            nome: file.name,
            base64: e.target.result,
            tipo: file.type || 'audio/mp3'
          },
          function(res) {
            if (res && res.sucesso) {
              configSistema.perguntas[indice].audio = res.url;
              var campo = document.getElementById('cfg-aud-' + indice);
              if (campo) campo.value = res.url;
              preCarregarAudiosEmCache();
              mostrarMensagem('Áudio salvo no Google Drive com sucesso!');
            }
          },
          function() {
            mostrarMensagem('Erro ao enviar áudio para o Drive.');
          }
        );
      };
      reader.readAsDataURL(file);
    }

    function enviarLogoParaGoogleDrive(input) {
      if (!input.files || !input.files[0]) return;
      var file = input.files[0];
      mostrarMensagem('Enviando logo para o Google Drive...');

      var reader = new FileReader();
      reader.onload = function(e) {
        chamarApiGAS(
          "uploadMidia",
          {
            nome: file.name,
            base64: e.target.result,
            tipo: file.type || 'image/png'
          },
          function(res) {
            if (res && res.sucesso) {
              var campo = document.getElementById('cfg-logo-url');
              if (campo) campo.value = res.url;
              configSistema.logoUrl = res.url;
              mostrarMensagem('Logo salvo no Drive com sucesso!');
            }
          },
          function() {
            mostrarMensagem('Erro ao enviar logo para o Drive.');
          }
        );
      };
      reader.readAsDataURL(file);
    }


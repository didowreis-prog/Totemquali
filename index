<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Avaliação de Atendimento</title>
  <style>
    * {
      -webkit-box-sizing: border-box;
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: rgba(0,0,0,0);
      -webkit-user-select: none;
      user-select: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
      background-color: #f4f6f9;
      color: #333333;
    }

    #app-container {
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    .secao {
      display: none;
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      padding: 28px 20px;
      text-align: center;
      background-color: #ffffff;
      overflow: hidden;
    }

    .secao.ativa {
      display: block;
    }

    .badge-identificacao-unidade {
      display: inline-block;
      font-size: 13px;
      font-weight: bold;
      color: #0284c7;
      background-color: #e0f2fe;
      border: 1px solid #bae6fd;
      border-radius: 12px;
      padding: 5px 14px;
      margin-bottom: 8px;
    }

    h1.titulo-principal {
      font-size: 40px;
      color: #0f172a;
      margin-top: 10px;
      margin-bottom: 16px;
      line-height: 1.25;
    }

    p.subtitulo {
      font-size: 24px;
      color: #475569;
      line-height: 1.45;
      max-width: 720px;
      margin: 0 auto 30px auto;
    }

    .pergunta-texto {
      font-size: 34px;
      font-weight: bold;
      color: #0f172a;
      margin-top: 10px;
      margin-bottom: 18px;
      line-height: 1.35;
      min-height: 75px;
      padding: 0 10px;
    }

    .area-audio {
      margin: 0 auto 20px auto;
      padding: 8px;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      max-width: 520px;
    }

    audio {
      width: 100%;
      height: 42px;
    }

    .opcoes-respostas {
      width: 100%;
      max-width: 960px;
      margin: 15px auto 25px auto;
      text-align: center;
      padding: 0 10px;
    }

    .opcao-btn {
      display: inline-block;
      vertical-align: top;
      background-color: #ffffff;
      border: 4px solid #e2e8f0;
      border-radius: 22px;
      padding: 24px 12px;
      cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.04);
      -webkit-transition: border-color 0.15s, background-color 0.15s;
      transition: border-color 0.15s, background-color 0.15s;
    }

    .opcoes-qtd-2 .opcao-btn {
      width: 40%;
      min-width: 180px;
      margin: 10px 3%;
    }

    .opcoes-qtd-3 .opcao-btn {
      width: 28%;
      min-width: 150px;
      margin: 8px 2%;
    }

    .opcoes-qtd-4 .opcao-btn {
      width: 21%;
      min-width: 130px;
      margin: 8px 1.5%;
    }

    .opcoes-qtd-5 .opcao-btn {
      width: 17%;
      min-width: 122px;
      margin: 8px 1%;
    }

    .opcao-btn .emoji {
      font-size: 64px;
      line-height: 1.1;
      display: block;
      margin-bottom: 12px;
    }

    .opcao-btn .rotulo {
      display: block;
      font-size: 20px;
      font-weight: bold;
      color: #334155;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .opcao-btn.selecionado {
      border-color: #0284c7;
      background-color: #f0f9ff;
    }

    .opcao-btn.selecionado .rotulo {
      color: #0284c7;
    }

    .area-botoes-acao {
      margin-top: 18px;
    }

    .btn-acao {
      display: inline-block;
      padding: 22px 55px;
      font-size: 26px;
      font-weight: bold;
      color: #ffffff;
      background-color: #0284c7;
      border: none;
      border-radius: 18px;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .btn-acao:active {
      opacity: 0.9;
    }

    .btn-avancar.desativado {
      opacity: 0.45;
      cursor: not-allowed;
      box-shadow: none;
    }

    .icone-sucesso {
      font-size: 88px;
      color: #16a34a;
      margin-top: 30px;
      margin-bottom: 16px;
    }

    .info-conclusao {
      font-size: 24px;
      color: #475569;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .logo-tela-inicial {
      max-height: 110px;
      max-width: 80%;
      margin: 0 auto 14px auto;
      display: block;
      object-fit: contain;
    }

    .btn-engrenagem-secreta {
      position: fixed;
      bottom: 14px;
      right: 14px;
      width: 52px;
      height: 52px;
      line-height: 52px;
      text-align: center;
      background-color: #e2e8f0;
      border: 1px solid #cbd5e1;
      border-radius: 26px;
      color: #475569;
      opacity: 0.42;
      cursor: pointer;
      z-index: 9999;
      padding: 0;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    }

    .btn-engrenagem-secreta svg {
      vertical-align: middle;
      display: inline-block;
    }

    .overlay-modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(15, 23, 42, 0.85);
      z-index: 10000;
      text-align: center;
    }

    .caixa-modal-ativacao {
      background-color: #ffffff;
      width: 90%;
      max-width: 560px;
      margin: 8% auto 0 auto;
      padding: 32px 26px;
      border-radius: 24px;
      box-shadow: 0 25px 50px rgba(0,0,0,0.45);
      text-align: center;
    }

    .input-codigo-6digitos {
      width: 85%;
      padding: 14px;
      font-size: 34px;
      text-align: center;
      border: 3px solid #0284c7;
      border-radius: 16px;
      margin: 18px auto;
      letter-spacing: 8px;
      color: #0f172a;
      font-weight: bold;
      background-color: #f0f9ff;
    }

    .caixa-modal-senha {
      background-color: #ffffff;
      width: 90%;
      max-width: 440px;
      margin: 14% auto 0 auto;
      padding: 30px 24px;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.35);
      text-align: center;
    }

    .input-senha-admin {
      width: 80%;
      padding: 14px;
      font-size: 26px;
      text-align: center;
      border: 2px solid #cbd5e1;
      border-radius: 12px;
      margin: 18px auto;
      letter-spacing: 6px;
      color: #0f172a;
    }

    .caixa-modal-config {
      background-color: #ffffff;
      width: 96%;
      max-width: 980px;
      height: 94%;
      margin: 1.5% auto;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      text-align: left;
      position: relative;
      overflow: hidden;
    }

    .config-cabecalho-moderno {
      padding: 16px 24px;
      background-color: #0f172a;
      color: #ffffff;
      border-bottom: 1px solid #1e293b;
      position: relative;
      overflow: hidden;
    }

    .btn-menu-hamburger {
      float: left;
      background-color: #1e293b;
      border: 1px solid #334155;
      color: #ffffff;
      font-size: 24px;
      line-height: 1;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      cursor: pointer;
      margin-right: 16px;
    }

    .config-header-textos {
      overflow: hidden;
    }

    .config-titulo-header {
      font-size: 20px;
      font-weight: bold;
      color: #f8fafc;
    }

    .config-subtitulo-header {
      font-size: 13px;
      color: #94a3b8;
      margin-top: 3px;
    }

    .drawer-menu-admin {
      display: none;
      position: absolute;
      top: 76px;
      left: 0;
      width: 290px;
      bottom: 75px;
      background-color: #0f172a;
      border-right: 2px solid #1e293b;
      z-index: 10500;
      box-shadow: 10px 0 25px rgba(0,0,0,0.4);
    }

    .item-menu-drawer {
      display: block;
      width: 100%;
      text-align: left;
      padding: 18px 24px;
      font-size: 16px;
      font-weight: bold;
      color: #94a3b8;
      background: none;
      border: none;
      border-bottom: 1px solid #1e293b;
      cursor: pointer;
    }

    .item-menu-drawer.drawer-ativo {
      color: #38bdf8;
      background-color: rgba(56, 189, 248, 0.12);
      border-left: 5px solid #38bdf8;
    }

    .config-conteudo-scroll {
      height: calc(100% - 151px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 26px 30px;
      background-color: #f8fafc;
    }

    .painel-secao-conteudo {
      display: none;
    }

    .painel-secao-conteudo.secao-ativa {
      display: block;
    }

    .card-config-moderno {
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 24px 28px;
      margin-bottom: 24px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .card-config-moderno h4 {
      font-size: 19px;
      color: #0f172a;
      margin-bottom: 6px;
      font-weight: bold;
    }

    .card-config-moderno p.descricao-card {
      font-size: 14px;
      color: #64748b;
      margin-bottom: 18px;
      line-height: 1.45;
    }

    .linha-campo-form {
      margin-bottom: 20px;
    }

    .rotulo-campo-admin {
      display: block;
      font-size: 15px;
      font-weight: bold;
      color: #334155;
      margin-bottom: 6px;
    }

    .input-admin-moderno {
      width: 100%;
      padding: 13px 16px;
      font-size: 16px;
      color: #0f172a;
      background-color: #ffffff;
      border: 2px solid #cbd5e1;
      border-radius: 10px;
      font-family: inherit;
    }

    .btn-preset-cor {
      display: inline-block;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      border: 3px solid #cbd5e1;
      margin-right: 10px;
      cursor: pointer;
      vertical-align: middle;
    }

    .card-pergunta-item {
      background-color: #ffffff;
      border: 2px solid #e2e8f0;
      border-radius: 16px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .badge-pergunta-numero {
      float: left;
      font-size: 17px;
      font-weight: bold;
      color: #0f172a;
      line-height: 34px;
    }

    .btn-remover-pergunta-admin {
      float: right;
      background-color: #fee2e2;
      color: #dc2626;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 7px 16px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }

    .faixa-audio-config {
      background-color: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 16px;
      margin-top: 14px;
      margin-bottom: 18px;
    }

    .btn-secundario-admin {
      display: inline-block;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: bold;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      cursor: pointer;
      margin-right: 8px;
      margin-top: 6px;
      background-color: #ffffff;
      color: #334155;
      text-decoration: none;
    }

    .btn-azul-admin {
      background-color: #0284c7;
      color: #ffffff;
      border-color: #0284c7;
    }

    .grid-opcoes-edicao {
      text-align: center;
      margin-top: 10px;
    }

    .card-opcao-edicao-col {
      display: inline-block;
      vertical-align: top;
      background-color: #f8fafc;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      padding: 12px 8px;
      margin: 6px 1%;
    }

    .input-emoji-edicao {
      width: 100%;
      text-align: center;
      font-size: 32px;
      padding: 6px 2px;
      border: 2px solid #cbd5e1;
      border-radius: 10px;
      background-color: #ffffff;
      margin-bottom: 8px;
    }

    .input-rotulo-edicao {
      width: 100%;
      text-align: center;
      font-size: 14px;
      font-weight: bold;
      padding: 8px 4px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background-color: #ffffff;
    }

    .bloco-controle-fonte {
      display: inline-block;
      margin-top: 10px;
    }

    .btn-ajuste-fonte {
      background-color: #0284c7;
      color: #ffffff;
      border: none;
      font-size: 26px;
      font-weight: bold;
      width: 54px;
      height: 50px;
      border-radius: 12px;
      cursor: pointer;
      vertical-align: middle;
    }

    .valor-fonte-exibicao {
      font-size: 22px;
      font-weight: bold;
      margin: 0 18px;
      display: inline-block;
      min-width: 75px;
      text-align: center;
      vertical-align: middle;
      color: #0f172a;
    }

    .config-rodape-moderno {
      padding: 14px 24px;
      background-color: #ffffff;
      border-top: 1px solid #e2e8f0;
      height: 75px;
      position: relative;
    }

    .rodape-assinatura-doca {
      float: left;
      line-height: 46px;
      font-size: 13px;
      font-weight: bold;
      color: #64748b;
      letter-spacing: 0.3px;
    }

    .rodape-botoes-direita {
      float: right;
    }

    .btn-fechar-dialogo {
      background-color: #64748b;
      color: #ffffff;
      border: none;
      padding: 12px 24px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
      margin-right: 12px;
    }

    .btn-salvar-dialogo {
      background-color: #16a34a;
      color: #ffffff;
      border: none;
      padding: 12px 28px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 10px;
      cursor: pointer;
    }

    .toast-notificacao {
      display: none;
      position: fixed;
      bottom: 75px;
      left: 50%;
      transform: translateX(-50%);
      -webkit-transform: translateX(-50%);
      background-color: #0f172a;
      color: #ffffff;
      padding: 14px 24px;
      font-size: 17px;
      border-radius: 10px;
      z-index: 20000;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      max-width: 90%;
    }
  </style>
</head>
<body>

  <div id="app-container">

    <!-- SEÇÃO 1: TELA INICIAL DO RESPONDENTE -->
    <div id="secao-1" class="secao ativa">
      <div id="bloco-badge-unidade" style="margin-top: 5px;">
        <span id="label-unidade-topo" class="badge-identificacao-unidade">Unidade Conectada</span>
      </div>
      <div id="bloco-logo-inicial" style="display: none; margin-top: 5px; margin-bottom: 12px;">
        <img id="img-logo-inicial" class="logo-tela-inicial" src="" alt="Logo" />
      </div>
      <h1 id="titulo-tela-inicial" class="titulo-principal">Pesquisa de Satisfação</h1>
      <p id="subtitulo-tela-inicial" class="subtitulo">
        Sua opinião é fundamental para aprimorarmos nosso atendimento.<br>
        O questionário é rápido e leva menos de 1 minuto.
      </p>

      <div style="margin-top: 35px;">
        <button id="btn-iniciar" class="btn-acao btn-primario-kiosk" type="button">
          TOQUE PARA INICIAR
        </button>
      </div>
    </div>

    <!-- SEÇÃO DE PERGUNTAS -->
    <div id="secao-pergunta" class="secao">
      <div id="texto-pergunta" class="pergunta-texto">Carregando...</div>

      <div class="area-audio">
        <audio id="player-visivel" controls preload="auto">
          Seu navegador não suporta áudio.
        </audio>
      </div>

      <div id="container-respostas-dinamico" class="opcoes-respostas"></div>

      <div class="area-botoes-acao">
        <button id="btn-avancar" class="btn-acao btn-primario-kiosk btn-avancar desativado" type="button" onclick="avancarPergunta()">
          AVANÇAR &rarr;
        </button>
      </div>
    </div>

    <!-- SEÇÃO FINAL: CONCLUSÃO -->
    <div id="secao-final" class="secao">
      <div class="icone-sucesso">&#10004;</div>
      <h1 class="titulo-principal" style="margin-top: 10px;">Muito Obrigado!</h1>
      <p class="info-conclusao">
        Sua avaliação foi registrada com sucesso.<br>
        Ela é muito importante para continuarmos melhorando nosso serviço.
      </p>

      <div class="area-botoes-acao">
        <button class="btn-acao btn-primario-kiosk" type="button" onclick="reiniciarPesquisa()">
          NOVA AVALIAÇÃO
        </button>
      </div>
    </div>

    <!-- Botão de Acesso Administrativo -->
    <button id="btn-engrenagem" class="btn-engrenagem-secreta" type="button" onclick="tocarEngrenagem(event)">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
      </svg>
    </button>

    <!-- Modal de Vinculação / Ativação (6 Dígitos) -->
    <div id="modal-ativacao-unidade" class="overlay-modal">
      <div class="caixa-modal-ativacao">
        <h2 style="font-size:26px; color:#0f172a; margin-bottom:8px;">Ativação do Totem</h2>
        <p style="color: #64748b; font-size: 15px; line-height: 1.45;">
          Digite o <strong>código de 6 dígitos</strong> cadastrado na aba <em>"Unidades"</em> da Planilha Google:
        </p>
        <input id="input-codigo-unidade" class="input-codigo-6digitos" type="text" maxlength="6" placeholder="000000" inputmode="numeric" pattern="[0-9]*" />
        
        <div style="margin-bottom: 16px; text-align: left;">
          <label style="font-size: 12px; font-weight: bold; color: #475569; display:block; margin-bottom:4px;">URL da API Google Apps Script:</label>
          <input id="input-api-url-ativacao" class="input-admin-moderno" type="text" style="font-size: 13px; padding: 8px 12px;" placeholder="https://script.google.com/macros/s/.../exec" />
        </div>

        <div>
          <button class="btn-acao btn-primario-kiosk" style="padding: 16px 36px; font-size: 20px;" type="button" onclick="confirmarAtivacaoUnidade()">
            Vincular Terminal
          </button>
        </div>
        <p id="msg-erro-ativacao" style="color: #dc2626; font-size: 14px; margin-top: 14px; font-weight: bold;"></p>
      </div>
    </div>

    <!-- Modal de Senha Administrativa -->
    <div id="modal-senha-admin" class="overlay-modal">
      <div class="caixa-modal-senha">
        <h2 style="font-size:24px; color:#0f172a; margin-bottom:8px;">Acesso Administrativo</h2>
        <p id="subtitulo-senha-modal" style="color: #64748b; font-size: 15px;">Digite a senha da unidade:</p>
        <input id="input-senha-tentativa" class="input-senha-admin" type="password" maxlength="16" placeholder="****" />
        <div style="margin-top: 15px;">
          <button class="btn-fechar-dialogo" type="button" onclick="fecharModalSenha()">Cancelar</button>
          <button class="btn-salvar-dialogo" type="button" onclick="confirmarSenhaAdmin()">Entrar</button>
        </div>
      </div>
    </div>

    <!-- Modal de Configurações com Hamburger Menu -->
    <div id="modal-configuracoes" class="overlay-modal">
      <div class="caixa-modal-config">
        
        <div class="config-cabecalho-moderno">
          <button class="btn-menu-hamburger" type="button" onclick="alternarDrawerMenu()">&#9776;</button>
          <div class="config-header-textos">
            <div id="titulo-secao-ativa" class="config-titulo-header">Identidade &amp; Cores</div>
            <div class="config-subtitulo-header">Toque no menu ☰ para navegar pelas opções do totem</div>
          </div>
        </div>

        <!-- Drawer Lateral do Hamburger Menu -->
        <div id="drawer-menu-admin" class="drawer-menu-admin">
          <button id="menu-item-unidade" class="item-menu-drawer" type="button" onclick="selecionarSecaoMenu('unidade', 'Unidade & Instalação')">
            &#127970; Unidade &amp; Instalação
          </button>

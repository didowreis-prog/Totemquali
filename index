    function aplicarPresetOpcoes(indicePergunta, quantidade) {
      sincronizarEstadoEdicaoPerguntas();
      if (quantidade === 2) {
        configSistema.perguntas[indicePergunta].opcoes = [
          { valor: 1, rotulo: "Não", emoji: "👎" },
          { valor: 2, rotulo: "Sim", emoji: "👍" }
        ];
      } else if (quantidade === 3) {
        configSistema.perguntas[indicePergunta].opcoes = [
          { valor: 1, rotulo: "Ruim", emoji: "🙁" },
          { valor: 2, rotulo: "Regular", emoji: "😐" },
          { valor: 3, rotulo: "Bom", emoji: "🙂" }
        ];
      } else {
        configSistema.perguntas[indicePergunta].opcoes = [
          { valor: 1, rotulo: "Péssimo", emoji: "😡" },
          { valor: 2, rotulo: "Ruim", emoji: "🙁" },
          { valor: 3, rotulo: "Regular", emoji: "😐" },
          { valor: 4, rotulo: "Bom", emoji: "🙂" },
          { valor: 5, rotulo: "Excelente", emoji: "😃" }
        ];
      }
      montarFormularioEdicaoPerguntas();
    }

    function sincronizarEstadoEdicaoPerguntas() {
      for (var i = 0; i < configSistema.perguntas.length; i++) {
        var p = configSistema.perguntas[i];
        var txtInput = document.getElementById('cfg-txt-' + i);
        if (txtInput) p.texto = txtInput.value;

        var audInput = document.getElementById('cfg-aud-' + i);
        if (audInput) p.audio = audInput.value;

        if (p.opcoes) {
          for (var j = 0; j < p.opcoes.length; j++) {
            var emInput = document.getElementById('cfg-op-em-' + i + '-' + j);
            if (emInput) p.opcoes[j].emoji = emInput.value || '⭐';

            var rotInput = document.getElementById('cfg-op-rot-' + i + '-' + j);
            if (rotInput) p.opcoes[j].rotulo = rotInput.value || ('Opção ' + (j + 1));
          }
        }
      }
    }


    function salvarConfiguracoesAdmin() {
      sincronizarEstadoEdicaoPerguntas();

      var inputUrlCfg = document.getElementById('cfg-api-url');
      if (inputUrlCfg && inputUrlCfg.value.trim() !== '') {
        salvarUrlApi(inputUrlCfg.value.trim());
      }

      configSistema.corBotao = document.getElementById('cfg-cor-botao').value || '#0284c7';
      configSistema.corFundo = document.getElementById('cfg-cor-fundo').value || '#f4f6f9';
      configSistema.logoUrl = document.getElementById('cfg-logo-url').value || '';
      configSistema.tituloInicial = document.getElementById('cfg-titulo-inicial').value || 'Pesquisa de Satisfação';
      configSistema.subtituloInicial = document.getElementById('cfg-subtitulo-inicial').value || '';
      
      var campoSenha = document.getElementById('cfg-senha-admin');
      if (campoSenha && campoSenha.value.trim() !== '') {
        configSistema.senhaAdmin = campoSenha.value.trim();
      }

      perguntas = configSistema.perguntas;

      try {
        if (configSistema.codigoUnidade) {
          window.localStorage.setItem('config_totem_appscript_' + configSistema.codigoUnidade, JSON.stringify(configSistema));
        }
      } catch (e) {}

      preCarregarAudiosEmCache();

      mostrarMensagem('Salvando alterações no Google Drive/Sheets...');
      chamarApiGAS(
        "salvarConfiguracoes",
        { config: configSistema },
        function(res) {
          mostrarMensagem(res.mensagem || 'Configurações salvas e sincronizadas!');
        },
        function() {
          mostrarMensagem('Salvo apenas localmente (falha de rede).');
        }
      );

      aplicarConfiguracoesVisuais();
      fecharModalConfig();

      var secaoPergunta = document.getElementById('secao-pergunta');
      if (secaoPergunta && secaoPergunta.className.indexOf('ativa') !== -1) {
        if (indiceAtual >= perguntas.length) indiceAtual = 0;
        carregarPergunta(indiceAtual);
      }
    }

    function sincronizarFilaPendente() {
      try {
        var armazenado = window.localStorage.getItem('avaliacoes_fila_pendente');
        if (!armazenado || armazenado === '[]') {
          mostrarMensagem('Nenhuma avaliação pendente na fila offline.');
          return;
        }
        var fila = JSON.parse(armazenado);
        mostrarMensagem('Enviando ' + fila.length + ' avaliação(ões) para o Sheets...');

        for (var i = 0; i < fila.length; i++) {
          (function(item) {
            chamarApiGAS(
              "registrarAvaliacao",
              { avaliacao: item },
              function() {
                removerItemFilaLocal(item.data_hora);
              }
            );
          })(fila[i]);
        }
        setTimeout(function() {
          mostrarMensagem('Sincronização concluída!');
          atualizarLinksGoogleNuvem();
        }, 2000);
      } catch (e) {
        mostrarMensagem('Erro ao ler fila pendente.');
      }
    }

    window.onload = function() {
      inicializarSistemaTotem();
    };
  </script>
</body>
</html>

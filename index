  <script>
    /* ==========================================================================
     *  CONFIGURAÇÃO DA API GOOGLE APPS SCRIPT (GITHUB PAGES)
     *  URL oficial da sua implantação no Google Apps Script:
     * ========================================================================== */
    var URL_API_PADRAO = "https://script.google.com/macros/s/AKfycbyKhI02D3sFNrSAUSjAk3QzmYfg1HyXt4mEi6RwnuFoIVnT5kbxgOxqUn4ct3A5dGiCiQ/exec"; 

    function obterUrlApi() {
      if (URL_API_PADRAO && URL_API_PADRAO.trim() !== '') return URL_API_PADRAO.trim();
      var salva = window.localStorage.getItem('totem_api_url');
      if (salva && salva.trim() !== '') return salva.trim();
      return "";
    }

    function salvarUrlApi(url) {
      if (url && url.trim() !== '') {
        window.localStorage.setItem('totem_api_url', url.trim());
      }
    }

    function chamarApiGAS(acao, dados, callbackSucesso, callbackErro) {
      var url = obterUrlApi();
      if (!url) {
        if (callbackErro) callbackErro({ mensagem: "URL da API Google Apps Script não configurada." });
        return;
      }

      var payload = {
        acao: acao,
        dados: dados || {}
      };

      try {
        var xhr = new XMLHttpRequest();
        xhr.open("POST", url, true);
        // text/plain previne que o navegador envie requisição preflight OPTIONS no Android 4 / CORS
        xhr.setRequestHeader("Content-Type", "text/plain;charset=utf-8");

        xhr.onreadystatechange = function() {
          if (xhr.readyState === 4) {
            if (xhr.status >= 200 && xhr.status < 400) {
              try {
                var json = JSON.parse(xhr.responseText);
                if (callbackSucesso) callbackSucesso(json);
              } catch (e) {
                if (callbackErro) callbackErro({ mensagem: "Erro ao processar resposta do servidor." });
              }
            } else {
              if (callbackErro) callbackErro({ mensagem: "Falha na comunicação com o servidor (" + xhr.status + ")." });
            }
          }
        };

        xhr.onerror = function() {
          if (callbackErro) callbackErro({ mensagem: "Erro de conexão de rede ou CORS com a API." });
        };

        xhr.send(JSON.stringify(payload));
      } catch (err) {
        if (callbackErro) callbackErro({ mensagem: "Erro ao disparar requisição: " + err.toString() });
      }
    }

    var configSistema = {
      codigoUnidade: "",
      nomeUnidade: "",
      escalaFonte: 100,
      senhaAdmin: "1234",
      corFundo: "#f4f6f9",
      corBotao: "#0284c7",
      tituloInicial: "Pesquisa de Satisfação",
      subtituloInicial: "Sua opinião é fundamental para aprimorarmos nosso atendimento.\nO questionário é rápido e leva menos de 1 minuto.",
      logoUrl: "",
      perguntas: []
    };

    var perguntas = [];
    var indiceAtual = 0;
    var respostaSelecionada = null;
    var avaliacaoAtual = {
      data_hora: "",
      codigoUnidade: "",
      nomeUnidade: "",
      respostas: []
    };

    var cacheAudiosMemoria = {};

    function preCarregarAudiosEmCache() {
      if (!perguntas || !perguntas.length) return;
      for (var i = 0; i < perguntas.length; i++) {
        var src = perguntas[i].audio || (i + 1) + '.mp3';
        if (src && !cacheAudiosMemoria[src]) {
          try {
            var aud = new Audio();
            aud.preload = "auto";
            aud.src = src;
            cacheAudiosMemoria[src] = aud;
          } catch (e) {}
        }
      }
    }

    function mostrarMensagem(texto) {
      var toast = document.getElementById('toast-aviso');
      if (toast) {
        toast.innerHTML = texto;
        toast.style.display = 'block';
        setTimeout(function() {
          toast.style.display = 'none';
        }, 3400);
      }
    }

    function normalizarOpcoesPergunta(p) {
      if (p.opcoes && p.opcoes.length) return p.opcoes;
      var arr = [];
      var ems = p.emojis || ["😡", "🙁", "😐", "🙂", "😃"];
      var rots = p.rotulos || ["Péssimo", "Ruim", "Regular", "Bom", "Excelente"];
      var qtd = Math.min(ems.length, rots.length);
      for (var j = 0; j < qtd; j++) {
        arr.push({
          valor: j + 1,
          rotulo: rots[j],
          emoji: ems[j]
        });
      }
      p.opcoes = arr;
      return arr;
    }

    function inicializarSistemaTotem() {
      var codigoSalvo = window.localStorage.getItem('totem_codigo_unidade');
      var urlSalva = obterUrlApi();

      if (!codigoSalvo || !urlSalva) {
        abrirModalAtivacao();
        return;
      }

      try {
        var cache = window.localStorage.getItem('config_totem_appscript_' + codigoSalvo);
        if (cache) {
          configSistema = JSON.parse(cache);
          for (var k = 0; k < configSistema.perguntas.length; k++) {
            normalizarOpcoesPergunta(configSistema.perguntas[k]);
          }
          perguntas = configSistema.perguntas;
          aplicarTamanhoFonte(configSistema.escalaFonte || 100);
          aplicarConfiguracoesVisuais();
          preCarregarAudiosEmCache();
        }
      } catch (e) {}

      sincronizarComBackendGoogle(codigoSalvo);
    }

    function sincronizarComBackendGoogle(codigo) {
      chamarApiGAS(
        "validarCodigo",
        { codigo: codigo },
        function(res) {
          if (res && res.valido && res.config) {
            configSistema = res.config;
            configSistema.codigoUnidade = res.codigo;
            configSistema.nomeUnidade = res.nome;
            for (var i = 0; i < configSistema.perguntas.length; i++) {
              normalizarOpcoesPergunta(configSistema.perguntas[i]);
            }
            perguntas = configSistema.perguntas;

            try {
              window.localStorage.setItem('totem_codigo_unidade', res.codigo);
              window.localStorage.setItem('config_totem_appscript_' + res.codigo, JSON.stringify(configSistema));
            } catch (e) {}

            aplicarTamanhoFonte(configSistema.escalaFonte || 100);
            aplicarConfiguracoesVisuais();
            preCarregarAudiosEmCache();
          } else if (res && !res.valido) {
            mostrarMensagem(res.mensagem || "Código não reconhecido na nuvem.");
            abrirModalAtivacao();
          }
        },
        function() {
          mostrarMensagem("Aviso: Operando em modo offline com a unidade " + codigo);
        }
      );
    }

    function abrirModalAtivacao() {
      var modal = document.getElementById('modal-ativacao-unidade');
      var input = document.getElementById('input-codigo-unidade');
      var inputUrl = document.getElementById('input-api-url-ativacao');
      var msg = document.getElementById('msg-erro-ativacao');
      if (msg) msg.innerHTML = '';
      if (input) input.value = window.localStorage.getItem('totem_codigo_unidade') || '';
      if (inputUrl) inputUrl.value = obterUrlApi() || '';
      if (modal) modal.style.display = 'block';
    }

    function fecharModalAtivacao() {
      var modal = document.getElementById('modal-ativacao-unidade');
      if (modal) modal.style.display = 'none';
    }

    function confirmarAtivacaoUnidade() {
      var input = document.getElementById('input-codigo-unidade');
      var inputUrl = document.getElementById('input-api-url-ativacao');
      var msg = document.getElementById('msg-erro-ativacao');
      var codigo = input ? input.value.trim() : '';
      var urlDigitada = inputUrl ? inputUrl.value.trim() : '';

      if (!urlDigitada) {
        if (msg) msg.innerHTML = 'Por favor, informe a URL da sua implantação do Apps Script.';
        return;
      }
      salvarUrlApi(urlDigitada);

      if (!codigo || codigo.length < 6) {
        if (msg) msg.innerHTML = 'Por favor, digite o código de 6 dígitos.';
        return;
      }

      if (msg) msg.innerHTML = 'Consultando Planilha Google...';

      chamarApiGAS(
        "validarCodigo",
        { codigo: codigo },
        function(res) {
          if (res && res.valido) {
            fecharModalAtivacao();
            configSistema = res.config;
            configSistema.codigoUnidade = res.codigo;
            configSistema.nomeUnidade = res.nome;
            perguntas = configSistema.perguntas;

            window.localStorage.setItem('totem_codigo_unidade', res.codigo);
            window.localStorage.setItem('config_totem_appscript_' + res.codigo, JSON.stringify(configSistema));

            aplicarTamanhoFonte(configSistema.escalaFonte || 100);
            aplicarConfiguracoesVisuais();
            preCarregarAudiosEmCache();
            mostrarMensagem("Totem vinculado com sucesso: " + res.nome);
          } else {
            if (msg) msg.innerHTML = (res && res.mensagem) ? res.mensagem : 'Código incorreto.';
          }
        },
        function(erro) {
          if (msg) msg.innerHTML = (erro && erro.mensagem) ? erro.mensagem : 'Erro ao conectar à API do Google.';
        }
      );
    }

    function desvincularUnidadeTablet() {
      window.localStorage.removeItem('totem_codigo_unidade');
      fecharModalConfig();
      abrirModalAtivacao();
      mostrarMensagem("Terminal desvinculado. Digite o novo código de 6 dígitos.");
    }

    function aplicarConfiguracoesVisuais() {
      var corFundo = configSistema.corFundo || '#f4f6f9';
      document.body.style.backgroundColor = corFundo;
      var secoes = document.getElementsByClassName('secao');
      for (var s = 0; s < secoes.length; s++) {
        secoes[s].style.backgroundColor = corFundo;
      }

      var corBotao = configSistema.corBotao || '#0284c7';
      var tagEstiloBotoes = document.getElementById('estilo-botoes-dinamico');
      if (!tagEstiloBotoes) {
        tagEstiloBotoes = document.createElement('style');
        tagEstiloBotoes.id = 'estilo-botoes-dinamico';
        document.head.appendChild(tagEstiloBotoes);
      }
      tagEstiloBotoes.innerHTML = 
        '.btn-primario-kiosk { background-color: ' + corBotao + ' !important; } ' +
        '.opcao-btn.selecionado { border-color: ' + corBotao + ' !important; } ' +
        '.opcao-btn.selecionado .rotulo { color: ' + corBotao + ' !important; }';

      var elTitulo = document.getElementById('titulo-tela-inicial');
      if (elTitulo) elTitulo.innerHTML = configSistema.tituloInicial || 'Pesquisa de Satisfação';

      var elSubtitulo = document.getElementById('subtitulo-tela-inicial');
      if (elSubtitulo) {
        var subFormatado = (configSistema.subtituloInicial || '').replace(/\n/g, '<br>');
        elSubtitulo.innerHTML = subFormatado;
      }

      var labelUnidade = document.getElementById('label-unidade-topo');
      if (labelUnidade) {
        if (configSistema.codigoUnidade) {
          labelUnidade.innerHTML = (configSistema.nomeUnidade || 'Unidade') + ' (' + configSistema.codigoUnidade + ')';
          labelUnidade.style.display = 'inline-block';
        } else {
          labelUnidade.style.display = 'none';
        }
      }

      var blocoLogo = document.getElementById('bloco-logo-inicial');
      var imgLogo = document.getElementById('img-logo-inicial');
      if (blocoLogo && imgLogo) {
        if (configSistema.logoUrl && configSistema.logoUrl.trim() !== '') {
          imgLogo.src = configSistema.logoUrl;
          blocoLogo.style.display = 'block';
        } else {
          blocoLogo.style.display = 'none';
          imgLogo.src = '';
        }
      }
    }

    function obterDataHoraAtual() {
      var d = new Date();
      var pad = function(n) { return n < 10 ? '0' + n : n; };
      return d.getFullYear() + '-' +
        pad(d.getMonth() + 1) + '-' +
        pad(d.getDate()) + ' ' +
        pad(d.getHours()) + ':' +
        pad(d.getMinutes()) + ':' +
        pad(d.getSeconds());
    }

    function iniciarPesquisa() {
      if (!configSistema.codigoUnidade) {
        abrirModalAtivacao();
        return;
      }

      if (!perguntas || perguntas.length === 0) {
        mostrarMensagem('Nenhuma pergunta configurada.');
        return;
      }

      indiceAtual = 0;
      respostaSelecionada = null;
      avaliacaoAtual = {
        data_hora: obterDataHoraAtual(),
        codigoUnidade: configSistema.codigoUnidade,
        nomeUnidade: configSistema.nomeUnidade,
        respostas: []
      };

      document.getElementById('secao-1').className = 'secao';
      document.getElementById('secao-final').className = 'secao';
      document.getElementById('secao-pergunta').className = 'secao ativa';

      carregarPergunta(indiceAtual);
    }

    var btnIniciar = document.getElementById('btn-iniciar');
    btnIniciar.addEventListener('click', iniciarPesquisa, false);
    btnIniciar.addEventListener('touchend', function(e) {
      iniciarPesquisa();
      e.preventDefault();
    }, false);

    function carregarPergunta(indice) {
      respostaSelecionada = null;

      var btnAvancar = document.getElementById('btn-avancar');
      btnAvancar.className = 'btn-acao btn-primario-kiosk btn-avancar desativado';

      var p = perguntas[indice];
      normalizarOpcoesPergunta(p);

      var textoPuro = p.texto.replace(/^\d+[\.\-\)]\s*/, '');
      document.getElementById('texto-pergunta').innerHTML = '(' + (indice + 1) + '/' + perguntas.length + ') ' + textoPuro;

      var container = document.getElementById('container-respostas-dinamico');
      var qtd = p.opcoes.length;
      container.className = 'opcoes-respostas opcoes-qtd-' + (qtd > 5 ? 5 : qtd);

      var html = '';
      for (var i = 0; i < qtd; i++) {
        var op = p.opcoes[i];
        var rotuloFormatado = (qtd > 2 ? op.valor + ' - ' : '') + op.rotulo;
        html += '<div class="opcao-btn" id="opcao-btn-' + i + '" onclick="selecionarOpcao(' + i + ')">';
        html += '<span class="emoji">' + op.emoji + '</span>';
        html += '<span class="rotulo">' + rotuloFormatado + '</span>';
        html += '</div>';
      }
      container.innerHTML = html;

      tocarAudioPergunta(p.audio || (indice + 1) + '.mp3');
    }

    function tocarAudioPergunta(fonte) {
      try {
        var player = document.getElementById('player-visivel');
        if (player && fonte) {
          player.pause();
          player.src = fonte;
          player.load();
          player.play();
        }
      } catch (e) {}
    }

    function selecionarOpcao(indiceOpcao) {
      var p = perguntas[indiceAtual];
      var op = p.opcoes[indiceOpcao];
      var rotuloFormatado = (p.opcoes.length > 2 ? op.valor + ' - ' : '') + op.rotulo;

      respostaSelecionada = {
        pergunta_id: p.id || (indiceAtual + 1),
        pergunta: p.texto,
        valor: op.valor,
        rotulo: op.rotulo,
        rotuloCompleto: rotuloFormatado,
        emoji: op.emoji
      };

      var botoes = document.getElementsByClassName('opcao-btn');
      for (var i = 0; i < botoes.length; i++) {
        botoes[i].className = 'opcao-btn' + (i === indiceOpcao ? ' selecionado' : '');
      }

      var btnAvancar = document.getElementById('btn-avancar');
      btnAvancar.className = 'btn-acao btn-primario-kiosk btn-avancar';
    }

    function avancarPergunta() {
      if (!respostaSelecionada) {
        mostrarMensagem('Toque em uma opção para continuar.');
        return;
      }

      avaliacaoAtual.respostas.push(respostaSelecionada);

      try {
        var player = document.getElementById('player-visivel');
        if (player) player.pause();
      } catch (e) {}

      indiceAtual++;

      if (indiceAtual < perguntas.length) {
        carregarPergunta(indiceAtual);
      } else {
        finalizarPesquisa();
      }
    }

    function finalizarPesquisa() {
      guardarFilaLocal(avaliacaoAtual);

      chamarApiGAS(
        "registrarAvaliacao",
        { avaliacao: avaliacaoAtual },
        function() {
          removerItemFilaLocal(avaliacaoAtual.data_hora);
        },
        function() {
          mostrarMensagem("Avaliação armazenada na fila offline do tablet.");
        }
      );

      document.getElementById('secao-pergunta').className = 'secao';
      document.getElementById('secao-final').className = 'secao ativa';

      setTimeout(function() {
        var secaoFinal = document.getElementById('secao-final');
        if (secaoFinal.className.indexOf('ativa') !== -1) reiniciarPesquisa();
      }, 5000);
    }

    function guardarFilaLocal(dados) {
      try {
        var lista = [];
        var armazenado = window.localStorage.getItem('avaliacoes_fila_pendente');
        if (armazenado) lista = JSON.parse(armazenado);
        lista.push(dados);
        window.localStorage.setItem('avaliacoes_fila_pendente', JSON.stringify(lista));
      } catch (e) {}
    }

    function removerItemFilaLocal(dataHora) {
      try {
        var armazenado = window.localStorage.getItem('avaliacoes_fila_pendente');
        if (!armazenado) return;
        var lista = JSON.parse(armazenado);
        var filtrado = [];
        for (var i = 0; i < lista.length; i++) {
          if (lista[i].data_hora !== dataHora) filtrado.push(lista[i]);
        }
        window.localStorage.setItem('avaliacoes_fila_pendente', JSON.stringify(filtrado));
      } catch (e) {}
    }

    function reiniciarPesquisa() {
      try {
        var player = document.getElementById('player-visivel');
        if (player) player.pause();
      } catch (e) {}
      document.getElementById('secao-final').className = 'secao';
      document.getElementById('secao-pergunta').className = 'secao';
      document.getElementById('secao-1').className = 'secao ativa';
    }

    var contagemToquesEngrenagem = 0;
    var timerToquesEngrenagem = null;
    var ultimoTimestampEngrenagem = 0;

    function tocarEngrenagem(e) {
      if (e && e.type === 'touchend') e.preventDefault();
      var agora = new Date().getTime();
      if (agora - ultimoTimestampEngrenagem < 120) return;
      ultimoTimestampEngrenagem = agora;

      contagemToquesEngrenagem++;
      if (timerToquesEngrenagem) clearTimeout(timerToquesEngrenagem);

      if (contagemToquesEngrenagem >= 3) {
        contagemToquesEngrenagem = 0;
        abrirModalSenha();
      } else {
        timerToquesEngrenagem = setTimeout(function() {
          contagemToquesEngrenagem = 0;
        }, 2200);
      }
    }

    var btnEng = document.getElementById('btn-engrenagem');
    if (btnEng) {
      btnEng.addEventListener('touchend', function(e) {
        tocarEngrenagem(e);
      }, false);
    }

    function abrirModalSenha() {
      var input = document.getElementById('input-senha-tentativa');
      var sub = document.getElementById('subtitulo-senha-modal');
      if (sub) {
        sub.innerHTML = 'Senha da Unidade ' + (configSistema.codigoUnidade || 'Geral') + ':';
      }
      if (input) input.value = '';
      document.getElementById('modal-senha-admin').style.display = 'block';
    }

    function fecharModalSenha() {
      document.getElementById('modal-senha-admin').style.display = 'none';
    }

    function confirmarSenhaAdmin() {
      var input = document.getElementById('input-senha-tentativa');
      var digitada = input ? input.value.trim() : '';
      if (!digitada) {
        mostrarMensagem('Digite a senha para continuar.');
        return;
      }

      if (digitada === String(configSistema.senhaAdmin).trim()) {
        fecharModalSenha();
        abrirModalConfig();
        return;
      }

      mostrarMensagem('Validando senha com a Planilha Google...');
      chamarApiGAS(
        "validarSenha",
        { senha: digitada, codigo: configSistema.codigoUnidade },
        function(res) {
          if (res && res.valida) {
            configSistema.senhaAdmin = digitada;
            fecharModalSenha();
            abrirModalConfig();
          } else {
            mostrarMensagem('Senha incorreta.');
          }
        },
        function() {
          mostrarMensagem('Falha ao validar com a nuvem.');
        }
      );
    }

